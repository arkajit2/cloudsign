{
  "name": "intelligent-goodall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pages:dev": "wrangler pages dev dist",
    "d1:migrate:local": "wrangler d1 migrations apply cloudsign-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cloudsign-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=cloudsign",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.6.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^3.114.17"
  }
}
